{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.0.8",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "icons": { "128": "icon-128.png" },
  "permissions": ["storage", "unlimitedStorage"],
  "action": { "default_popup": "popup.html", "default_title": "DLook" },
  "host_permissions": ["https://dlook.site/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://*.dlsite.com/*/work/*",
      "https://*.dlsite.com/*/cart",
      "https://*.dlsite.com/*/cart?*",
      "https://*.dlsite.com/*/cart/*",
      "https://*.dlsite.com/*/mypage/wishlist",
      "https://*.dlsite.com/*/mypage/wishlist?*",
      "https://*.dlsite.com/*/mypage/wishlist/*"
    ],
    "exclude_matches": ["https://play.dlsite.com/*"],
    "js": ["language.js", "currency.js", "current-price.js", "platform.js", "wishlist-filter.js", "cart-campaigns.js", "purchase-offers.js", "content.js"],
    "css": ["badge.css", "badge-layout.css"],
    "run_at": "document_end"
  }, {
    "matches": ["https://play.dlsite.com/*"],
    "js": ["play/loader.js"],
    "css": ["play/styles/host.css"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["dlook-logo.svg"],
    "matches": ["https://*.dlsite.com/*"]
  }, {
    "resources": ["play/*", "play/core/*", "play/data/*", "play/ui/*", "play/ui/views/*", "play/styles/*", "play/offline/*"],
    "matches": ["https://play.dlsite.com/*"]
  }]
}
